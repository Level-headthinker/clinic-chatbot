# Copy this file to .env and fill in your values
# Never commit .env to GitHub

# ── Core (required) ────────────────────────────────────────────
# Full SQLAlchemy URL. Managed Postgres MUST include ?sslmode=require.
DATABASE_URL=postgresql://user:password@localhost:5432/clinicbot
DB_PASSWORD=your_strong_password_here
SECRET_KEY=your_secret_key_here_min_32_chars
GROQ_API_KEY=your_groq_api_key_here
CORS_ORIGINS=https://yourdomain.com,http://localhost:3000

# Deployment label — controls fail-closed behaviour. In "production" the
# WhatsApp webhook REJECTS unsigned requests (META_APP_SECRET becomes mandatory).
ENVIRONMENT=development

# ── Launch blockers (set before going live) ────────────────────
# Error monitoring + alerting. Blank = failures only hit the logs, nobody is
# paged. Set the DSN (Sentry → Project → Settings → Client Keys) to get alerted
# when the bot goes dark, emails fail, or a scheduled job stops.
SENTRY_DSN=
# Redis for rate-limit + webhook de-dup shared across workers. Blank = in-memory
# (OK for ONE worker only). REQUIRED before you scale past a single worker,
# otherwise Meta's webhook retries can double-reply / double-book.
REDIS_URL=

# ── Email (optional — leave blank to disable) ──────────────────
MAIL_EMAIL=
MAIL_PASSWORD=
ADMIN_EMAIL=

# ── Meta WhatsApp Cloud API ────────────────────────────────────
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=clinicbot_verify
# App Secret (Meta → App → Settings → Basic). REQUIRED in production —
# incoming WhatsApp webhooks are HMAC-verified (X-Hub-Signature-256) when set.
# With ENVIRONMENT=production and this blank, ALL webhooks are rejected.
META_APP_SECRET=

# WhatsApp message templates (pre-approved in Meta) — required to deliver
# reminders OUTSIDE the 24-hour customer-service window. Blank = free-form text,
# which only delivers within 24h. See backend/app/services/WHATSAPP_TEMPLATES.md.
WA_TEMPLATE_LANG=en
WA_TEMPLATE_NEXT_VISIT=
WA_TEMPLATE_LEAD_NUDGE=
WA_TEMPLATE_APPT_REMINDER=

# ── Billing (Pakistan: use Safepay — Stripe is unavailable) ────
APP_BASE_URL=http://localhost:3000
# "manual" = test mode, no real money. Switch to "safepay" for live billing.
PAYMENT_PROVIDER=manual
SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENV=sandbox

# ── Voice (optional) ───────────────────────────────────────────
# Shared secret VAPI must send as X-Vapi-Secret to /voice/vapi-server and
# /voice/vapi-llm. Blank = those endpoints are CLOSED (503).
VAPI_SERVER_SECRET=
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VOICE_BRANCH_SLUG=

# VIS — self-hosted voice service for WhatsApp voice notes (STT + TTS)
# Point this at your running VIS instance. VIS_API_KEY must match VIS's API_KEY.
VIS_API_URL=
VIS_API_KEY=
# Languages that reply to a voice note WITH a voice note (others reply as text).
# Default English only; use "en,ur,ur-roman" once VIS has ElevenLabs for Urdu.
WHATSAPP_VOICE_LANGS=en
